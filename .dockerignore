# Docker does NOT read .gitignore -- this file is its own equivalent, and
# anything not listed here gets copied into the image by `COPY . .`.

# Secrets. These must never be baked into an image: anyone who obtains the
# image can read them back out, and images get pushed to registries.
.env
.streamlit/secrets.toml

# A Windows virtualenv is useless inside a Linux container, and it's large.
# Dependencies are installed fresh from requirements.txt during the build.
venv/

__pycache__/
*.pyc

# Local artifacts with no purpose in a running container. The run ledger is
# listed for the same reason as .env: it is local state that records which
# companies were researched, and baking it into an image would ship that to
# whoever pulls the image. Memory is off unless MEMORY_PATH is set, so a
# container has none of this unless it is configured to.
memory.jsonl
*.jsonl
report-*.md

# Nothing below is read at runtime: the only file the app opens that is not
# code is example-report.md, which stays. COPY . . would otherwise bake all
# of this into a published image.
#
# prep/ is personal job-prep material, kept out of git for the same reason.
# .claude/ holds a second checkout of this repository as a git worktree.
# The GIF is a 20MB README animation, assets/ its screenshots, and
# benchmarks/cache/ is cached provider responses from benchmark runs.
prep/
.claude/
*.gif
assets/
docs/
benchmarks/cache/
streamlit_out.log
streamlit_err.log
.git/
.devcontainer/
