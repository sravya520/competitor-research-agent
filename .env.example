# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Required ---------------------------------------------------------------

# Google Gemini. Free tier, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Tavily search + extract. Free tier 1,000 credits/month, no card:
# https://app.tavily.com
# Not needed when RETRIEVAL_PROVIDER names a backend that does not use Tavily,
# such as "parallel" or "firecrawl".
TAVILY_API_KEY=your-tavily-key-here


# --- Optional ---------------------------------------------------------------

# Firecrawl search + scrape. Only needed when RETRIEVAL_PROVIDER is
# "firecrawl" or "hybrid". Free tier 1,000 credits/month:
# https://firecrawl.dev
FIRECRAWL_API_KEY=your-firecrawl-key-here

# Parallel Search MCP needs no account and no API key, so there is nothing to
# set here; select it with RETRIEVAL_PROVIDER=parallel. Service limits apply.
# https://docs.parallel.ai/integrations/mcp/search-mcp

# Which retrieval backend to use. Defaults to "tavily" when unset.
#   tavily     Tavily search + Tavily extract        (default, production)
#   parallel   Parallel Search MCP, anonymous, no API key
#   firecrawl  Firecrawl search + Firecrawl scrape
#   hybrid     Tavily search + Firecrawl scrape
# An unrecognised value falls back to tavily with a warning.
RETRIEVAL_PROVIDER=tavily

# Memory is OFF unless this is set, and it is left commented out on purpose.
# There is no default location: with MEMORY_PATH unset, nothing is read and
# nothing is written, which is how the hosted demo runs. Set it to switch
# memory on locally.
#
# What it stores: one JSON line per finished run, holding the company, the
# competitors kept and excluded, and which model and retrieval backend ran.
# Reading it back lets a repeat run reuse a recent identity instead of
# establishing it again. Delete the file to forget everything.
#
# It records which companies were researched, so it is gitignored and kept
# out of Docker images. Streamlit Cloud's disk is ephemeral, so a file there
# disappears on restart; point this at durable storage if the history is to
# survive.
# MEMORY_PATH=memory.jsonl
