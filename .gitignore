venv/
.env
.streamlit/secrets.toml

# Local assistant/editor session state, not part of the project.
.claude/
__pycache__/
*.pyc

# Generated reports — one is committed as example-report.md
report-*.md

# The run ledger (memory.py). Records which companies someone researched
# and when, which is client-identifying for real freelance use, so it stays
# local. MEMORY_PATH names the file and may name any of these, so the
# pattern is broader than the default.
memory.jsonl
*.jsonl

streamlit_out.log
streamlit_err.log

# Personal interview/job-prep material — deliberately not public.
# docs/ is public project documentation; prep/ is not.
prep/

# Cached provider responses and raw benchmark output. Summaries under
# benchmarks/results/ ARE committed; the raw cache is not.
benchmarks/cache/
