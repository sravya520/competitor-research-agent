# Copy to .streamlit/secrets.toml (gitignored and dockerignored) and fill in.
# On Streamlit Community Cloud, paste the same content under Advanced settings -> Secrets.
# On Render or any container host, use environment variables for the API keys and DATABASE_URL
# and mount/paste this file's [auth] block as .streamlit/secrets.toml.

GEMINI_API_KEY = "your-gemini-key"
TAVILY_API_KEY = "your-tavily-key"

[auth]
# Must match an "Authorized redirect URI" in your Google OAuth client EXACTLY.
#   local:       http://localhost:4000/oauth2callback
#   production:  https://YOUR-DOMAIN/oauth2callback   (https is required)
redirect_uri = "http://localhost:4000/oauth2callback"
# Any long random string; signs the login cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "replace-with-a-long-random-string"
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (type: Web application)
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
